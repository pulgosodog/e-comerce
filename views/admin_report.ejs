<section class="dashboard-container">
  <div class="view-toggle-container">
    <div class="segmented-control" role="tablist" aria-label="Vista del reporte">
      <button class="segment-btn active" type="button">Resumen de <b>Ventas</b></button>
      <button class="segment-btn" type="button">Resumen de <b>Inventario</b></button>
    </div>
  </div>

  <div class="filter-container">
    <form method="get" action="/admin/reporte" class="filter-container">
      <select class="report-dropdown" name="period" aria-label="Filtro de periodo" onchange="this.form.submit()">
        <option value="weekly" <%= selectedPeriod === 'weekly' ? 'selected' : '' %>>Semanal</option>
        <option value="monthly" <%= selectedPeriod === 'monthly' ? 'selected' : '' %>>Mensual</option>
        <option value="yearly" <%= selectedPeriod === 'yearly' ? 'selected' : '' %>>Anual</option>
      </select>
    </form>
  </div>

  <div class="metrics-grid">
    <article class="metric-card">
      <div class="metric-title">Ingresos</div>
      <div class="metric-value">$<%= Number(reportData.revenue || 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></div>
      <div class="metric-footer">
        <span class="metric-trend <%= reportData.trends.revenue.direction %>">
          <i class="fa-solid <%= reportData.trends.revenue.direction === 'up' ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' %>"></i>
          <%= reportData.trends.revenue.value %>%
        </span>
        <span class="vs-text">vs periodo anterior</span>
      </div>
    </article>

    <article class="metric-card">
      <div class="metric-title">Órdenes</div>
      <div class="metric-value"><%= reportData.totalOrders %></div>
      <div class="metric-footer">
        <span class="metric-trend <%= reportData.trends.orders.direction %>">
          <i class="fa-solid <%= reportData.trends.orders.direction === 'up' ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' %>"></i>
          <%= reportData.trends.orders.value %>%
        </span>
        <span class="vs-text">pedidos confirmados</span>
      </div>
    </article>

    <article class="metric-card">
      <div class="metric-title">Promedio por orden</div>
      <div class="metric-value">$<%= Number(reportData.averageOrderValue || 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></div>
      <div class="metric-footer">
        <span class="metric-trend <%= reportData.trends.averageOrderValue.direction %>">
          <i class="fa-solid <%= reportData.trends.averageOrderValue.direction === 'up' ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' %>"></i>
          <%= reportData.trends.averageOrderValue.value %>%
        </span>
        <span class="vs-text">valor promedio</span>
      </div>
    </article>

    <article class="metric-card">
      <div class="metric-title">Productos vendidos</div>
      <div class="metric-value"><%= reportData.productsSold %></div>
      <div class="metric-footer">
        <span class="metric-trend <%= reportData.trends.productsSold.direction %>">
          <i class="fa-solid <%= reportData.trends.productsSold.direction === 'up' ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' %>"></i>
          <%= reportData.trends.productsSold.value %>%
        </span>
        <span class="vs-text">unidades del periodo</span>
      </div>
    </article>
  </div>

  <div class="visuals-grid">
    <section class="chart-card">
      <div class="chart-header">
        <h3 class="chart-title">Resumen de órdenes</h3>
      </div>
      <div class="chart-wrapper">
        <canvas id="chartOrderSummary"></canvas>
      </div>
    </section>

    <section class="chart-card">
      <div class="chart-header">
        <h3 class="chart-title">Resumen de ingresos</h3>
      </div>
      <div class="chart-wrapper">
        <canvas id="chartRevenueSummary"></canvas>
      </div>
    </section>

    <section class="chart-card">
      <div class="chart-header">
        <h3 class="chart-title">Ventas por categoría</h3>
      </div>
      <div class="chart-wrapper">
        <canvas id="chartVentasCategoria"></canvas>
      </div>
    </section>
  </div>
</section>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const dashboardData = <%- JSON.stringify(reportData) %>;

  document.addEventListener('DOMContentLoaded', function () {
    const labels = dashboardData.ordersSeries?.labels || [];
    const orderValues = dashboardData.ordersSeries?.orderCounts || [];
    const revenueValues = dashboardData.ordersSeries?.revenueValues || [];
    const categoryLabels = dashboardData.categoryChart?.labels || [];
    const categoryValues = dashboardData.categoryChart?.values || [];

    const maxOrders = Math.max(...orderValues, 1);
    const suggestedMaxY = Math.ceil(maxOrders * 1.15);

    const ctxOrder = document.getElementById('chartOrderSummary').getContext('2d');
    new Chart(ctxOrder, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          data: orderValues,
          borderColor: '#e64a19',
          backgroundColor: 'rgba(230, 74, 25, 0.1)',
          borderWidth: 3,
          fill: true,
          tension: 0.3,
          pointBackgroundColor: '#e64a19',
          pointRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, max: suggestedMaxY, ticks: { stepSize: Math.max(1, Math.ceil(suggestedMaxY / 5)) } },
          x: { grid: { display: false } }
        }
      }
    });

    const ctxRevenue = document.getElementById('chartRevenueSummary').getContext('2d');
    new Chart(ctxRevenue, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          data: revenueValues,
          backgroundColor: '#007680',
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { callback: value => '$' + value } },
          x: { grid: { display: false } }
        }
      }
    });

    const ctxCat = document.getElementById('chartVentasCategoria').getContext('2d');
    new Chart(ctxCat, {
      type: 'doughnut',
      data: {
        labels: categoryLabels,
        datasets: [{
          data: categoryValues.length ? categoryValues : [1],
          backgroundColor: ['#007680', '#d81b60', '#7e57c2', '#ffca28', '#1f9d8a', '#4caf50'],
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { weight: 'bold', size: 11 } } }
        }
      }
    });
  });
</script>